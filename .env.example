VITE_ADMIN_PASSWORD=change-me

# Firebase (valores públicos del "Web App" en la configuración de tu proyecto Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Variables SOLO de servidor (sin prefijo VITE_): úsalas solo en las
# funciones serverless de /api/, agrégalas en Vercel → Settings →
# Environment Variables. NUNCA les pongas el prefijo VITE_, o Vite las
# incluiría en el bundle público del navegador.

# EGW Writings API (app registrada en cpanel.egwwritings.org, grant client_credentials)
EGW_CLIENT_ID=
EGW_CLIENT_SECRET=

# Cuenta de servicio de Firebase (Firebase Console → Configuración del
# proyecto → Cuentas de servicio → Generar nueva clave privada), usada
# solo por api/_egwAuth.js para guardar el token de EGW Writings.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
