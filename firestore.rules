rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Los estudios son de lectura pública (los ve cualquier visitante del sitio),
    // pero solo el admin autenticado (Firebase Auth) puede crear/editar/borrar.
    match /studies/{studyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Las plantillas solo se usan dentro del panel de administración.
    match /templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    // Tokens de integraciones de servidor (ej. OAuth de EGW Writings).
    // Solo el SDK admin (funciones serverless) puede tocar esto — se
    // salta estas reglas, así que ningún cliente (ni el admin autenticado)
    // debe poder leer/escribir aquí directamente.
    match /_serverTokens/{docId} {
      allow read, write: if false;
    }
  }
}
